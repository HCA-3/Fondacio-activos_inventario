# Solo hace falta para correr el backend fuera de Docker (uv run ...).
# Con "docker compose up" no se usa: compose.yaml ya define estas variables.
# Copia este archivo como .env y ajusta los valores.

DATABASE_URL=postgresql+psycopg://fondacio:fondacio@localhost:5432/fondacio

# La cookie de sesión exige HTTPS salvo que esto sea false. En local, déjalo en false.
COOKIE_SECURE=false
